 "font_size": 14,
 "html": "<style>\r\n@page {\r\n    size: A4;\r\n    margin: 2cm;\r\n}\r\n.page-break {\r\n    page-break-before: always;\r\n}\r\n\r\n@media print {\r\n    button, input {\r\n        display: none !important;\r\n    }\r\n}\r\n\r\n.total {\r\n    font-size: 22px;\r\n    font-weight: bold;\r\n}\r\n.urgent {\r\n    color: red;\r\n    font-weight: bold;\r\n    text-align: center;\r\n}\r\n</style>\r\n\r\n<h2>{{ _(get_shop_name()) }}</h2>\r\n\r\n{% if doc.priority == \"Urgent\" %}\r\n<div class=\"urgent\">{{ _(\"URGENT\") }}</div>\r\n{% endif %}\r\n\r\n<h4>{{ _(\"Customer Details\") }}</h4>\r\n<p>{{ _(\"Name\") }}: {{ doc.customer_name }}</p>\r\n\r\n<h4>{{ _(\"Device Details\") }}</h4>\r\n<p>{{ _(\"Brand\") }}: {{ doc.device_brand }}</p>\r\n<p>{{ _(\"Model\") }}: {{ doc.device_model }}</p>\r\n\r\n{% if doc.parts_used|length > 10 %}\r\n<div class=\"page-break\"></div>\r\n{% endif %}\r\n\r\n<h4>{{ _(\"Parts Used\") }}</h4>\r\n<table border=\"1\" width=\"100%\">\r\n<tr>\r\n    <th>{{ _(\"Part\") }}</th>\r\n    <th>{{ _(\"Qty\") }}</th>\r\n    <th>{{ _(\"Rate\") }}</th>\r\n    <th>{{ _(\"Amount\") }}</th>\r\n</tr>\r\n\r\n{% for p in doc.parts_used %}\r\n<tr>\r\n    <td>{{ p.part_name }}</td>\r\n    <td>{{ p.qty }}</td>\r\n    <td>\u20b9 {{ \"{:,.2f}\".format(p.rate or 0) }}</td>\r\n    <td>\u20b9 {{ \"{:,.2f}\".format(p.amount or 0) }}</td>\r\n</tr>\r\n{% endfor %}\r\n</table>\r\n\r\n<div class=\"total\">\r\n    {{ _(\"Final Amount\") }}: \u20b9 {{ \"{:,.2f}\".format(doc.final_amount or 0) }}\r\n</div>\r\n\r\n<p>{{ doc.print_summary }}</p>\r\n\r\n<div style=\"text-align:center; margin-top:20px;\">\r\n    <p>{{ _(\"Scan to view Job Card\") }}</p>\r\n    <img src=\"data:image/png;base64,{{ get_qr_code(doc.name) }}\" width=\"120\">\r\n</div>",
